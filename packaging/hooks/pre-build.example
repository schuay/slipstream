#!/bin/sh
# Copyright 2026 The slipstream developers
# SPDX-License-Identifier: MIT

# Copy to <config-directory>/hooks/pre-build and make executable.
# macOS: save the previous AC power mode, then select Low Power for quiet builds.
# Requires the exact pmset sudo rules in ../sudoers/slipstream-power.example.
# The hook runner supplies SLIPSTREAM_PYTHON and SLIPSTREAM_HOOK_STATE_DIR.
exec "${SLIPSTREAM_PYTHON:-python3}" -m slipstream.power_hooks low
