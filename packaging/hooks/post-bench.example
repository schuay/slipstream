#!/bin/sh
# Copyright 2026 The slipstream developers
# SPDX-License-Identifier: MIT

# Copy to <config-directory>/hooks/post-bench and make executable.
# Restore and verify the AC power settings saved by pre-bench.
# Also called after a failed pre-bench or benchmark; no snapshot is a no-op.
exec "${SLIPSTREAM_PYTHON:-python3}" -m slipstream.power_hooks restore
