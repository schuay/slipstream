#!/usr/bin/env bash
# Copyright 2026 The slipstream developers
# SPDX-License-Identifier: MIT

# Check staged files using only the environment prepared outside the sandbox.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

mapfile -d '' -t staged_files < <(
  git diff --cached --name-only --diff-filter=ACM -z
)
staged_py=()
for path in "${staged_files[@]}"; do
  [[ $path == *.py ]] && staged_py+=("$path")
done

if ((${#staged_py[@]})); then
  uv run --offline --no-sync ruff format --check -- "${staged_py[@]}"
  uv run --offline --no-sync ruff check -- "${staged_py[@]}"
fi

if ((${#staged_files[@]})); then
  uv run --offline --no-sync python scripts/add-license-headers.py \
    --check --files "${staged_files[@]}"
fi

# Prose stays out of this repository: README.md is the one markdown file it
# carries. Anything else -- design notes, runbooks, incident write-ups --
# belongs in a private place, and a doc that lands here by habit is in the
# public history for good. Renames count, so moving a doc in is caught too.
markdown_allowed=(README.md)
mapfile -d '' -t staged_new < <(
  git diff --cached --name-only --diff-filter=ACR -z
)
markdown_rejected=()
for path in "${staged_new[@]}"; do
  lower=${path,,}
  [[ $lower == *.md || $lower == *.markdown || $lower == *.mdx ]] || continue
  allowed=0
  for ok in "${markdown_allowed[@]}"; do
    [[ $path == "$ok" ]] && allowed=1
  done
  ((allowed)) || markdown_rejected+=("$path")
done
if ((${#markdown_rejected[@]})); then
  echo "markdown outside the allowlist (${markdown_allowed[*]}):" >&2
  printf '  %s\n' "${markdown_rejected[@]}" >&2
  echo "keep docs out of the public repo; edit markdown_allowed in" \
    "scripts/pre-commit for a deliberate exception" >&2
  exit 1
fi

scripts/check-private-patterns staged
