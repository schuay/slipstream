# Slipstream user configuration
# Save this as ~/.config/slipstream/config.toml (`slipstream config` prints
# it) and edit the paths to match your local setup.
#
# Every section is closed: a key slipstream does not read is a startup error,
# not a comment. That includes keys that exist in the bundled config but are
# not yours to override, and engine or suite names slipstream does not know.

out_dir = "~/jsc-js2"   # where results, logs, and metadata are stored
# results_dir = "results" # subdirectory within out_dir (default: "results")

# Names this machine wherever its numbers sit beside another machine's: in the
# perf database and in the db itself. One db holds one bot.
# bot_name = "my-machine-local"

# An engine is configured by the presence of its table. src_dir is the local
# checkout; omit it on a machine that only benches artifacts fetched from the
# build bus, and every command that needs git will say so by name.
[engines.v8]
src_dir = "~/src/v8/v8"
# build_cmd = "..."   # override the bundled default if this box builds
# sync_cmd = "..."    # differently from the other one
# gn_args = """..."""
#
# run_set lists what has to be packaged for the binary to run on another
# machine, relative to src_dir: directories are taken recursively, symlinks are
# preserved. Required to publish to the bus, and hashed into the artifact's
# build_cfg_hash, since it is as much an input to the numbers as the build args
# are. Audit it on the target platform before filling it in: dropping a
# framework or dereferencing a symlink is not visible in the resulting scores.
# run_set = ["out/release-lto/d8", "out/release-lto/icudtl.dat"]

[engines.jsc]
src_dir = "~/src/WebKit"
# The default archives matching arm64e WebKit frameworks, XPC helpers and MiniBrowser.
# Only Source/JavaScriptCore commits are selected. Keep ARCHS/VALID_ARCHS=arm64e
# and the generic Mac destination on overrides.

# chrome is built from chromium's checkout around V8: the builder reads
# chromium's history for the CLs that roll v8_revision in DEPS and builds the
# roll CL once per V8 commit it covers, with src/v8 pinned to that commit. So
# on the building box it needs [engines.v8] with a src_dir too, read for V8's
# history (the copy under src/v8 sits wherever the last sync left it), and
# gclient on PATH. A box that only benches chrome from the bus needs neither.
# Its keys have two parts, "<chromium position>-<v8 position>", wherever a
# key is spelled: [build] from, --retry, bus status.
# [engines.chrome]
# src_dir = "~/src/chromium/src"

# safari is Safari Technology Preview around jsc's WebKit build: nothing is
# compiled, each entry is a jsc entry's blobs plus the installed app, keyed
# "<STP number>-<WebKit position>" with the number assigned by the builder per
# distinct installed STP (auto-update stays on; a new build string is a new
# number). The building box needs STP installed and src_dir pointing at the
# directory holding "Safari Technology Preview.app", plus [engines.jsc]
# publishing the full runtime; only such jsc entries are taken. A benching box
# needs an empty table, system Safari (its development launcher is the
# process), and no Safari of any kind running: a run is refused beside one,
# and accepted only once the launcher and its WebContent processes are seen
# to have loaded the run root's frameworks.
# [engines.safari]
# src_dir = "/Applications"

[benchmarks.js2]
dir = "~/JetStream2"

[benchmarks.js3]
dir = "~/src/JetStream"

# Speedometer 3 runs only in a browser (chrome, safari), so it needs no
# shell and a [[run]] pairing it with v8 or jsc is refused. The checkout is
# https://github.com/WebKit/Speedometer at release/3.1; main is 4.0 alpha.
# One run is one page load with the page's own 10 iterations; each suite's
# mean time goes in as Total-Time and Speedometer's Score as Overall.
# [benchmarks.sp3]
# dir = "~/src/Speedometer"

# What this machine measures of every commit. Nothing runs that is not listed
# here: the matrix is a choice about what is worth an hour of bot time, so a
# flag worth running on one suite need not be run on the others.
#
# variant names the series in the db and in the perf frontends. Omit it and it
# is the flag with its dashes turned to underscores, or "default" with no
# flags; two entries may not end up with the same engine/suite/variant.
#
# Both boxes should list the same matrix. `slipstream bus status` compares
# them and reports the difference, since a variant only one box collects looks
# like a regression in the other's series.
#
# Adding an entry does not backfill: commits already measured stay done. To
# fill history for a new variant, `slipstream clear` the range, which re-runs
# every entry for those commits, not only the new one.
#
# runs is how many times each commit is measured with the entry (default 3).
# It is per entry because the suites' noise differs: the same engine can take
# three rounds of js3 and five of sp3. The count is part of what `bus status`
# compares, since the same series measured a different number of times on
# each box differs in noise.

[[run]]
engine = "v8"
suite = "js3"

# run_mode = "per_benchmark" invokes the harness once per line item instead of
# once for the suite. It prints no overall score, so one is synthesized as the
# geometric mean of the line items.
[[run]]
engine = "v8"
suite = "js3"
variant = "per_line_item"
run_mode = "per_benchmark"

[[run]]
engine = "v8"
suite = "js2"
flags = ["--turbolev-future"]   # variant: "turbolev_future"

[[run]]
engine = "jsc"
suite = "js2"

[[run]]
engine = "jsc"
suite = "js3"

# [[run]]
# engine = "chrome"
# suite = "sp3"
# runs = 5

# [push]
# bot_name = "my-machine-local"   # must match the top-level bot_name
#
# At least one target is required. Each is either a spanner database or a
# spool_dir for a machine that can reach one.
#
# The perf Spanner database:
#
# [[push.targets]]
# spanner = "project/instance/database"
# # refresh = true    # aggregate once per delivery cycle, including idle cycles
# # Staging is in transition between two table designs (see spanner.py).
# # write names what a push writes: "both" (default), "legacy" or "samples";
# # aggregate_from names what refresh reads: "samples" (default) or "legacy".
# # Reading a design that is not written is rejected. aggregate_into names
# # the aggregate table(s) refresh writes: "both" (default), "benchmarks" or
# # "benchmarks_v2"; only benchmarks_v2 can hold a browser (embedder) point.
# # write = "both"
# # aggregate_from = "samples"
# # aggregate_into = "both"
#
# A machine without Spanner access appends each push to a spool log:
#
# [[push.targets]]
# spool_dir = "~/slipstream/outbox"
# # retain_days = 90                   # entries are dropped once older
#
# and a machine that can ssh to it drains the log into its own targets with
# `slipstream deliver`, tracking what it has read in <cursor_dir>/<bot_name>.cursor:
#
# [[relay]]
# ssh_host = "box2"                    # SSH config alias
# spool_dir = "~/slipstream/outbox"    # on box2
# bot_name = "box2-bot"                # bot the spooled scores belong to
# # cursor_dir = "..."                 # local; default <out_dir>/relay

# The build bus: box2 builds every commit and publishes an artifact, both boxes
# bench from it. `slipstream build` publishes, `slipstream watch` consumes.
#
# [bus]
# root = "~/slipstream/bus"          # entries, payloads, fetch tmp, run roots
#
# One entry per source this machine consumes. `name` is the cursor directory
# component, so the local source is named too; an engine with no source is
# git-driven, which is how a single box runs today, and two sources may not
# claim the same engine.
#
# [[bus.sources]]
# name = "box2"
# ssh_host = "box2"                  # omit for a bus root on this machine
# root = "~/slipstream/bus"          # as box2's shell expands it
# engines = ["v8", "jsc"]            # optional subset; omit to take everything
# # bwlimit = "20000"                # rsync --bwlimit, KB/s
#
# What this machine builds and publishes:
#
# [build]
# engines = ["v8", "jsc"]
# retain_gb = 400                    # per engine, oldest entries dropped first
# min_free_gb = 100                  # stop publishing below this
# max_infra_attempts = 5             # before a stuck sync is blamed on the commit
# max_consecutive_burns = 3          # before the builder stalls instead
# batch = 0                          # jobs per hold of the machine before a
#                                    # waiting bench gets a turn; 0 = all known
# # from = { v8 = 109680 }           # only used when an engine has no state;
#                                    # an embedded engine's key is "EMBEDDER-COMMIT"
# # A changed run_set entry is published as bsdiff patches against the newest
# # full archive at that path, unless the patches would exceed this share of
# # the archive, in which case it is stored whole and becomes the next base.
# delta_max_ratio = 0.5              # 0 publishes full archives only
# delta_min_mb = 4                   # archives under this are stored whole
# delta_block_mb = 8                 # patch granularity over the tar stream
# delta_workers = 0                  # bsdiff processes; 0 = one per core, capped
#
# [bench]
# min_free_gb = 100                  # a payload plus its unpacked root at once
# run_roots = 2                      # unpacked roots kept per engine
# max_consecutive_failures = 3       # commits with no scores before it stalls

# macOS only: `bench` and `watch` check the host power state before starting a
# session. Configure the machine once with `slipstream host --apply`; "abort"
# is the right setting for a dedicated bot, which should never run in a state
# that lets it suspend or throttle.
#
# [host]
# preflight = "warn"    # "warn" (default), "abort", or "off"

# Delivery runs separately from collector-only watch. Keep [[relay]] for remote
# spool sources; the relay CLI is removed. All omitted keys use these defaults.
# [delivery]
# local = true                      # false on remote-only / build-only machines
# remote = true                     # false to disable configured SSH sources
# poll_seconds = 600                # sleep only when no delivery progress is made
# max_units = 16
# max_rows = 100000                  # soft cycle bound
# max_bytes = 8388608                # soft cycle bound (8 MiB)
# max_payload_bytes = 67108864       # hard individual payload bound (64 MiB)
# cycle_seconds = 120               # stop starting new units after this budget
# lock_seconds = 30
# io_seconds = 30                   # supervised Spanner operation / SSH transfer
# shutdown_seconds = 15
# retry_seconds = 5
# max_retry_seconds = 300
